 "heroVideo": null,
 "blocks": [
  {
   "t": "figure",
   "html": "<img src=\"@img:images/pwr-nox004a_6fnsf0ay.jpg\" alt=\"minelab equinox power nox battery\" title=\"minelab equinox power bank\" width=\"214\" height=\"134\">"
  },
  {
   "t": "h2",
   "html": "Pwr-Nox Power Pack for Minelab Equinox Detectors"
  },
  {
   "t": "p",
   "html": "Double the battery life and detecting time of your Minelab Equinox with the Pwr-Nox Power Pack."
  },
  {
   "t": "figure",
   "html": "<img src=\"@img:images/pwr-nox002a_ig2l0m52.jpg\" alt=\"power nox minelab equinox battery pack\" title=\"minelab equinox battery\" width=\"214\" height=\"214\">"
  },
  {
   "t": "p",
   "html": "This lightweight, compact unit fits neatly to the upper stem via the arm cup screw and its front clip. Connect to the control Equinox box using the standard Equinox USB charge cable."
  },
  {
   "t": "figure",
   "html": "<img src=\"@img:images/pwr-nox003a.jpg\" alt=\"usb battery for minelab equinox\" title=\"minelab equinox usb battery\" width=\"213\" height=\"213\">"
  },
  {
   "t": "p",
   "html": "The fully charged power pack has the same capacity as the standard Equinox rechargeable battery, effectively doubling your time detecting without needing to charge."
  },
  {
   "t": "figure",
   "html": "<img src=\"@img:images/pwr-nox006a.jpg\" alt=\"extend battery life minelab equinox\" title=\"equinox 800 battery\" width=\"213\" height=\"213\">"
  },
  {
   "t": "p",
   "html": "The unit can be recharged with the included USB to Micro-USB charge lead, taking power from a mains adaptor, vehicle output or almost any USB enabled power source."
  }
 ],
