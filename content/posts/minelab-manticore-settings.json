  {
   "t": "figure",
   "html": "<img src=\"@img:images/detexpert-logosml_383z1pp5.png\" alt=\"setting up a minelab manticore with the best settings for beach and fields\" title=\"Minelab manticore settings\" width=\"60\" height=\"89\">"
