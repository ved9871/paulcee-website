  },
  {
   "t": "p",
   "html": "<a href=\"http://bit.ly/2VcUX0q\" data-kind=\"affiliate\"><img src=\"@img:images/hoard_3.jpg\" alt=\"silver coin from hamblendon hoard uk\" title=\"silver coin from a hoard\" width=\"316\" height=\"178\"></a><a href=\"http://bit.ly/2VcUX0q\" data-kind=\"affiliate\"><img src=\"@img:images/hoard_2.jpg\" alt=\"hoard of gold found metal detecting\" title=\"silver coin of a hoard in the uk found metal detecting\" width=\"317\" height=\"178\"></a>"
  },
  {
   "t": "p",
   "html": "This was a live feed from when the coins were first discovered at Spring Detectival"
  },
